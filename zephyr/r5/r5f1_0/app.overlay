#include <zephyr/dt-bindings/interrupt-controller/ti-vim.h>

/*
 * TI-SCI, the device manager's API. Zephyr's TI-SCI driver talks to it over
 * this host's (40) threads on main_sec_proxy0: 83 (low_priority,
 * write) and 81 (response, read; k3conf show threads). The polled mailbox
 * driver in common/src/sproxy.c carries it, since no secure proxy interrupt
 * reaches an R5F here. reg is the device manager's debug window, which the
 * binding asks for and nothing reads.
 */
/ {
	ai64_sproxy: mailbox@32c00000 {
		compatible = "ai64,secure-proxy-poll";
		reg = <0x32c00000 0x100000>, <0x32400000 0x100000>;
		reg-names = "target_data", "rt";
		#mbox-cells = <1>;
	};

	dmsc: system-controller@44083000 {
		compatible = "ti,k2g-sci";
		reg = <0x44083000 0x1000>;
		ti,host-id = <40>;
		mboxes = <&ai64_sproxy 81>, <&ai64_sproxy 83>;
		mbox-names = "rx", "tx";
	};
};

/*
 * The mailbox interrupt route this core asks the device manager for at boot
 * (common/src/tisci.c), through Zephyr's TI-SCI driver.
 * NAVSS0_MAILBOX_2 user 1 arrives on NAVSS0_INTR_ROUTER_0
 * (device 213) input 429. Output 260 is the first of this host's range
 * (k3conf dump rm 213) and lands on this core's VIM input 228.
 */
/ {
	ai64_tisci: tisci-route {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <429>;
		ir-output = <260>;
	};
};

/* The board puts the mailbox on VIM 256, which nothing routes to. */
&mbox2 {
	interrupts = <0 228 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
};

/*
 * The links to the other three R5F cores (common/ai64_ipc.dtsi). This core's
 * doorbells are NAVSS0_MAILBOX_10 user 2, which arrives on router input
 * 398 (TI-SCI's pend_intr 1); output 261, the next of this host's range,
 * lands on VIM input 229.
 */
#define AI64_IPC_SELF 2
#include "../common/ai64_ipc.dtsi"

/ {
	ai64_tisci_ipc: tisci-route-ipc {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <398>;
		ir-output = <261>;
	};

	AI64_IPC_LINK(2, 0)
	AI64_IPC_LINK(2, 1)
	AI64_IPC_LINK(2, 3)
};

/*
 * R5F1_0's job: a square wave on P8.18 (src/blink.c).
 *
 * The pad, AJ23 at 0x010, is GPIO0_4 in mux mode 7. Bits 5:4 of a J721E
 * pad register pick which of the main domain's GPIO0, GPIO2, GPIO4, and
 * GPIO6 drives it (1 is GPIO2). Linux owns GPIO0, and has outputs in every
 * one of its banks, but leaves GPIO2 disabled, so this core takes GPIO2
 * whole: Zephyr's GPIO driver sets every pin of a bank to input when it
 * starts. GPIO2's power and clock come from the device manager (device
 * 107), which the power domain turns on at boot.
 */
#include <zephyr/dt-bindings/pinctrl/ti-k3-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

#define AI64_GPIO2_SEL (1 << 4)

&pinctrl {
	ai64_blink_p8_18: ai64-blink-p8-18 {
		/* P8.18 AJ23 GPIO0_4, here GPIO2_4, mode 7 */
		pinmux = <K3_PINMUX(0x0010, PIN_OUTPUT | AI64_GPIO2_SEL, MUX_MODE_7)>;
	};
};

/ {
	power-domains {
		gpio2_pd: gpio2-pd {
			compatible = "ti,sci-pm-domain";
			tisci,device-id = <107>;
			tisci,device-mode = "EXCLUSIVE";
			#power-domain-cells = <0>;
		};
	};

	zephyr,user {
		blink-gpios = <&main_gpio2 4 GPIO_ACTIVE_HIGH>;
	};
};

/* GPIO2's first bank, pins 0 to 31 (main_gpio2 maps pin n to it). */
&main_gpio2_0 {
	power-domains = <&gpio2_pd>;
	pinctrl-0 = <&ai64_blink_p8_18>;
	pinctrl-names = "default";
	status = "okay";
};
