// SPDX-License-Identifier: MIT
#include <zephyr/dt-bindings/pinctrl/ti-k3-pinctrl.h>
#include <freq.h>
#include <zephyr/dt-bindings/interrupt-controller/ti-vim.h>

/*
 * Carve the bulk chunk region out of R5F0_0 DDR: 64 KiB at 0xa2fef000,
 * matching AI64_BULK_ADDR. ddr1 starts at 0xa2200000; the board's ddr1
 * (14 MiB) ended at 0xa3000000, and the last 4 KiB stay unused.
 */

&ddr1 {
	reg = <0xa2200000 0xdef000>;
};

/*
 * 0x200000 is the pad's TX-disable bit (PIN_DISABLE in the Linux header),
 * OR mux mode 7, so a shorted partner ball stays off. The K3 pinctrl helper
 * applies only the first two pinmux cells of each group, so each group has
 * one pin.
 */
#define AI64_PIN_OFF 0x200000

/ {
	ai64_bulk: memory@a2fef000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa2fef000 0x10000>;
		zephyr,memory-region = "AI64_BULK";
	};

	/*
	 * Main SPI7. Linux leaves it disabled, and the board firmware keeps
	 * its power domain on. The driver polls, so there is no interrupt.
	 * Its functional clock is 50 MHz: with 48 here, the driver's divider
	 * of 48 for 1 MHz gave a 0.96 us clock on a logic analyzer.
	 */
	main_spi7: spi@2170000 {
		compatible = "ti,omap-mcspi";
		reg = <0x02170000 0x400>;
		clock-frequency = <DT_FREQ_M(50)>;
		ti,spi-num-cs = <1>;
		ti,d1-miso-d0-mosi;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ai64_spi7_clk &ai64_spi7_cs0 &ai64_spi7_d0
			     &ai64_spi7_off_p9_31b &ai64_spi7_off_p9_28b
			     &ai64_spi7_off_p9_30b>;
		status = "okay";
	};
};

&pinctrl {
	ai64_spi7_clk: ai64-spi7-clk {
		/* P9.31a U3 EXT_REFCLK1.SPI7_CLK, mode 6 */
		pinmux = <K3_PINMUX(0x0234, PIN_OUTPUT, MUX_MODE_6)>;
	};
	ai64_spi7_cs0: ai64-spi7-cs0 {
		/* P9.28a U2 ECAP0_IN_APWM_OUT.SPI7_CS0, mode 6 */
		pinmux = <K3_PINMUX(0x0230, PIN_OUTPUT, MUX_MODE_6)>;
	};
	ai64_spi7_d0: ai64-spi7-d0 {
		/* P9.30a V6 TIMER_IO0.SPI7_D0, MOSI, mode 6 */
		pinmux = <K3_PINMUX(0x0238, PIN_OUTPUT, MUX_MODE_6)>;
	};
	ai64_spi7_off_p9_31b: ai64-spi7-off-p9-31b {
		/* P9.31b AB26, shorted to P9.31a */
		pinmux = <K3_PINMUX(0x00d4, AI64_PIN_OFF, MUX_MODE_7)>;
	};
	ai64_spi7_off_p9_28b: ai64-spi7-off-p9-28b {
		/* P9.28b AF28, shorted to P9.28a */
		pinmux = <K3_PINMUX(0x00b0, AI64_PIN_OFF, MUX_MODE_7)>;
	};
	ai64_spi7_off_p9_30b: ai64-spi7-off-p9-30b {
		/* P9.30b AE28, shorted to P9.30a */
		pinmux = <K3_PINMUX(0x00b4, AI64_PIN_OFF, MUX_MODE_7)>;
	};
};

/*
 * TI-SCI, the device manager's API. Zephyr's TI-SCI driver talks to it over
 * this host's (35) threads on main_sec_proxy0: 63 (low_priority,
 * write) and 61 (response, read; k3conf show threads). The polled mailbox
 * driver in common/src/sproxy.c carries it, since no secure proxy interrupt
 * reaches an R5F here. reg is the device manager's debug window, which the
 * binding asks for and nothing reads.
 */
/ {
	ai64_sproxy: mailbox@32c00000 {
		compatible = "ai64,secure-proxy-poll";
		reg = <0x32c00000 0x100000>, <0x32400000 0x100000>;
		reg-names = "target_data", "rt";
		#mbox-cells = <1>;
	};

	dmsc: system-controller@44083000 {
		compatible = "ti,k2g-sci";
		reg = <0x44083000 0x1000>;
		ti,host-id = <35>;
		mboxes = <&ai64_sproxy 61>, <&ai64_sproxy 63>;
		mbox-names = "rx", "tx";
	};
};

/*
 * The mailbox interrupt route this core asks the device manager for at boot
 * (common/src/tisci.c), through Zephyr's TI-SCI driver.
 * NAVSS0_MAILBOX_1 user 2 arrives on NAVSS0_INTR_ROUTER_0
 * (device 213) input 434. Output 196 is the first of this host's range
 * (k3conf dump rm 213) and lands on this core's VIM input 228.
 */
/ {
	ai64_tisci: tisci-route {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <434>;
		ir-output = <196>;
	};
};

/* The board puts the mailbox on VIM 256, which nothing routes to. */
&mbox1 {
	interrupts = <0 228 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
};

/*
 * The links to the other three R5F cores (common/ai64_ipc.dtsi). This core's
 * doorbells are NAVSS0_MAILBOX_11 user 1, which arrives on router input 393
 * (TI-SCI's pend_intr 0); output 197, the next of this host's range, lands
 * on VIM input 229.
 */
#define AI64_IPC_SELF 0
#include "../common/ai64_ipc.dtsi"

/ {
	ai64_tisci_ipc: tisci-route-ipc {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <393>;
		ir-output = <197>;
	};

	AI64_IPC_LINK(0, 1)
	AI64_IPC_LINK(0, 2)
	AI64_IPC_LINK(0, 3)
};
