#include <zephyr/dt-bindings/pinctrl/ti-k3-pinctrl.h>
#include <zephyr/dt-bindings/interrupt-controller/ti-vim.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * R5F0_1's job: EHRPWM4 output B on P9.25 (src/ai64_pwm.c).
 *
 * 0x200000 is the pad's TX-disable bit (PIN_DISABLE in the Linux header),
 * OR mux mode 7, so the shorted partner ball stays off. The K3 pinctrl
 * helper applies only the first two pinmux cells of each group, so each
 * group has one pin.
 */
#define AI64_PIN_OFF 0x200000

&pinctrl {
	ai64_epwm4_b: ai64-epwm4-b {
		/* P9.25b W26 RGMII6_RXC.EHRPWM4_B, mode 6 */
		pinmux = <K3_PINMUX(0x01a4, PIN_OUTPUT, MUX_MODE_6)>;
	};
	ai64_epwm4_off_p9_25a: ai64-epwm4-off-p9-25a {
		/* P9.25a AC4, shorted to P9.25b */
		pinmux = <K3_PINMUX(0x0200, AI64_PIN_OFF, MUX_MODE_7)>;
	};
};

/*
 * Zephyr's EHRPWM driver (ti,am3352-ehrpwm). Its functional clock and power
 * come from the device manager over TI-SCI (dmsc, below): device 87, clock
 * 0, as in the Linux device tree's main_ehrpwm4. The power domain turns the
 * module on at boot. The time-base clock gate is CTRLMMR_EPWM4_CTRL bit 0,
 * at 0x4150 in CTRL_MMR0 (Linux's ehrpwm_tbclk 4), in the partition that
 * kicks at 0x5008. Linux leaves EHRPWM4 alone once install-beagle.sh has
 * taken the stock image's epwm4 overlay out of its boot entry.
 * src/ai64_pwm.c drives it, through the pwms of /zephyr,user.
 */
/ {
	main_ctrl_mmr0: syscon@100000 {
		compatible = "ti,control-module", "syscon";
		reg = <0x00100000 0x1c000>;
		ti,unlock-offsets = <0x5008>;
		#epwm-tbclk-cells = <2>;
	};

	power-domains {
		epwm4_pd: epwm4-pd {
			compatible = "ti,sci-pm-domain";
			tisci,device-id = <87>;
			tisci,device-mode = "EXCLUSIVE";
			#power-domain-cells = <0>;
		};
	};

	main_ehrpwm4: pwm@3040000 {
		compatible = "ti,am3352-ehrpwm";
		reg = <0x03040000 0x100>;
		clocks = <&k3_clks 87 0>;
		tbclk = <&main_ctrl_mmr0 0x4150 0>;
		power-domains = <&epwm4_pd>;
		pinctrl-0 = <&ai64_epwm4_b &ai64_epwm4_off_p9_25a>;
		pinctrl-names = "default";
		#pwm-cells = <3>;
	};

	zephyr,user {
		/* Output B is channel 1. 1 kHz until the steps start. */
		pwms = <&main_ehrpwm4 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
	};
};

/*
 * TI-SCI, the device manager's API. Zephyr's TI-SCI driver talks to it over
 * this host's (37) threads on main_sec_proxy0: 73 (low_priority,
 * write) and 71 (response, read; k3conf show threads). The polled mailbox
 * driver in src/ai64_sproxy.c carries it, since no secure proxy interrupt
 * reaches an R5F here. reg is the device manager's debug window, which the
 * binding asks for and nothing reads.
 */
/ {
	ai64_sproxy: mailbox@32c00000 {
		compatible = "ai64,secure-proxy-poll";
		reg = <0x32c00000 0x100000>, <0x32400000 0x100000>;
		reg-names = "target_data", "rt";
		#mbox-cells = <1>;
	};

	dmsc: system-controller@44083000 {
		compatible = "ti,k2g-sci";
		reg = <0x44083000 0x1000>;
		ti,host-id = <37>;
		mboxes = <&ai64_sproxy 71>, <&ai64_sproxy 73>;
		mbox-names = "rx", "tx";

		k3_clks: clock-controller {
			compatible = "ti,k2g-sci-clk";
			#clock-cells = <2>;
		};
	};
};

/*
 * The mailbox interrupt routes this core asks the device manager for at
 * boot (src/ai64_tisci.c), through Zephyr's TI-SCI driver, both on
 * NAVSS0_INTR_ROUTER_0 (device 213), whose outputs 228 to 255 are this
 * host's (k3conf dump rm 213) and land on this core's VIM inputs 228 to 255:
 * - Linux's doorbell, NAVSS0_MAILBOX_1 user 1: router input 433, output 228,
 *   VIM 228.
 * - The other R5F cores' doorbells, NAVSS0_MAILBOX_10 user 1
 *   (boards/ai64_ipc.dtsi): router input 397 (TI-SCI's pend_intr 0),
 *   output 229, VIM 229.
 */
/ {
	ai64_tisci: tisci-route {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <433>;
		ir-output = <228>;
	};

	ai64_tisci_ipc: tisci-route-ipc {
		compatible = "ai64,tisci-irq-route";
		ir-id = <213>;
		ir-input = <397>;
		ir-output = <229>;
	};
};

/* The board puts the mailbox on VIM 256, which nothing routes to. */
&mbox1 {
	interrupts = <0 228 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
};

#define AI64_IPC_SELF 1
#include "ai64_ipc.dtsi"

/ {
	AI64_IPC_LINK(1, 0)
	AI64_IPC_LINK(1, 2)
	AI64_IPC_LINK(1, 3)
};
