# One app for the four main-domain R5F cores. sysbuild.cmake builds it once
# per core, and each core's boards/<board>.conf picks its job here. Every
# core also answers Linux over eRPC, sits on the fabric, and links to the
# other three over ipc_service (src/ai64_ipc.c).

menu "BeagleBone AI-64 demo"

choice AI64_JOB
	prompt "This core's job"

config AI64_JOB_SPI
	bool "SPI7 on header P9, and the UART2 console"
	help
	  R5F0_0. Writes SPI7 for Linux and for the other cores, and holds
	  the bulk buffer Linux writes.

config AI64_JOB_PWM
	bool "EHRPWM4 on P9.25"
	help
	  R5F0_1. Runs the step program on P9.25 and takes fixed settings
	  from Linux, the other cores, and fabric routes.

config AI64_JOB_BLINK
	bool "A square wave on P8.18 from a kernel timer"
	help
	  R5F1_0. Toggles GPIO0_4 from a k_timer and measures how late each
	  toggle is, on the GTC.

config AI64_JOB_MONITOR
	bool "Pings the other three cores and collects their status"
	help
	  R5F1_1. Measures each link's round trip and gathers every core's
	  job status for Linux.

endchoice

config AI64_DMA
	bool "A UDMA memory-to-memory channel (src/ai64_dma.c)"
	default y if AI64_JOB_SPI
	help
	  R5F0_0. Copies between DDR and the DSPs' memories for Linux's
	  dmaCopy call, with the main NAVSS UDMA.

config AI64_PIPE
	bool "This core's stage of the pipeline (zephyr/include/ai64_pipe.h)"
	default y if AI64_JOB_SPI || AI64_JOB_PWM
	select AI64_DMA if AI64_JOB_SPI
	help
	  R5F0_0 copies each window of P8.31 samples from ICSSG0 into C66x
	  0's L2 SRAM with its UDMA (src/ai64_pipe_dma.c). R5F0_1 sets P9.25
	  from the class the C7x finds for it, and keeps score
	  (src/ai64_pipe_pwm.c).

config AI64_BLINK_HALF_PERIOD_US
	int "Half period of the P8.18 square wave, in microseconds"
	depends on AI64_JOB_BLINK
	default 500

config AI64_MONITOR_PERIOD_MS
	int "How often the monitor pings every core, in milliseconds"
	depends on AI64_JOB_MONITOR
	default 100

endmenu

source "Kconfig.zephyr"
