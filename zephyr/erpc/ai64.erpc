/*
 * Linux calls these Zephyr functions over each R5F core's RPMsg channel.
 * Any core takes spiWrite, setPwm, and setPwmSteps, and passes them to the
 * core whose job they are. Bulk bytes stay in the DDR region from
 * ai64_shm.h. They are not eRPC payload.
 */
program ai64

interface Ai64Service {
    say(in string msg) -> string
    setPwm(in uint32 periodNs, in uint32 dutyNs) -> int32
    setPwmSteps(in uint32 stepMs) -> int32
    takeChunk(in uint32 seq, in uint32 length, in uint32 crc) -> uint32
    spiWrite(in string text) -> string
    status() -> string
}
